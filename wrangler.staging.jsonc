{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wink-admin-staging",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "SENTRY_DSN": ""
  },
  "routes": [
    { "pattern": "staging.admin.usewink.app", "custom_domain": true }
  ]
}
