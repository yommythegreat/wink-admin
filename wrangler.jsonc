{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PRODUCTION config. wrangler.staging.jsonc is the staging equivalent.
  "name": "wink-admin",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "vars": {
    "SENTRY_DSN": ""
  },
  "routes": [
    { "pattern": "admin.usewink.app", "custom_domain": true }
  ]
}
